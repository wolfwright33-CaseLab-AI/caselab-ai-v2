# Configure these as environment variables on Render. Never commit real credentials.
CASELAB_DEMO_PASSCODE=replace-with-private-demo-password
LIVEAVATAR_API_KEY=replace-with-your-key
LIVEAVATAR_AVATAR_ID=alex-avatar-uuid
LIVEAVATAR_CONTEXT_ID=alex-context-uuid
LIVEAVATAR_VOICE_ID=alex-voice-uuid
# Sarah activates automatically when BOTH fields below are configured
SARAH_AVATAR_ID=
SARAH_CONTEXT_ID=
SARAH_VOICE_ID=
LIVEAVATAR_MAX_SECONDS=600
MAX_DEMO_SESSIONS=10
OPENAI_API_KEY=replace-with-your-key
OPENAI_FEEDBACK_MODEL=gpt-4o-mini
